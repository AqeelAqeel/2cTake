{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://www.2ctake.com",
          "https://2ctake.com",
          "https://*.vercel.app",
          "http://localhost:5173",
          "http://localhost:3000"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
