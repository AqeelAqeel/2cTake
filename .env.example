
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

OPENAI_API_KEY=

# ─── Quo texting (server-only — never VITE_ prefixed) ─────────────────────
# API key from the Quo dashboard. Auth header is the raw key (NO "Bearer").
NEXT_QUO_API_KEY=
# The workspace number texts are sent FROM (E.164) and its Quo IDs.
QUO_FROM_NUMBER=
QUO_USER_ID=
QUO_PHONE_NUMBER_ID=
# Signing secret for the inbound-message webhook (starts with whsec_).
# Set after POST /v1/webhooks/messages registers /api/quo-webhook.
QUO_WEBHOOK_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ─── Cloudflare R2 storage ────────────────────────────────────────────────
# Feature flag — set to "true" to route new uploads/reads through R2.
# Leave unset (or "false") to keep the Supabase Storage path. Flip to true
# in Vercel after the backfill script has copied existing blobs.
VITE_USE_R2=

# Client-safe: public base URL for the artifacts bucket (R2.dev subdomain
# or custom domain). e.g. https://pub-xxxxxxxx.r2.dev
VITE_R2_ARTIFACTS_PUBLIC_BASE=

# Server-only — set in Vercel project env vars AND via `supabase secrets set`
# so both Vercel functions and Supabase edge functions can read them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ARTIFACTS_BUCKET=2ctake-artifacts
R2_RECORDINGS_BUCKET=2ctake-recordings

# Needed by the Vercel /api/r2-presign-* functions to validate share tokens
# and session ownership. DO NOT prefix with VITE_ — it must never hit the
# browser bundle.
SUPABASE_SERVICE_ROLE_KEY=